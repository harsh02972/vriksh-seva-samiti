# Copy this file to .env.local and fill in the values.
# Supabase dashboard → Project Settings → API Keys (and → Data API for the URL).

# Project URL, e.g. https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Publishable key (starts with sb_publishable_). Safe in the browser: it only has
# the rights of an anonymous visitor, which the database rules restrict to public views.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# The live website address (no trailing slash). Used for share previews, sitemap and robots.txt.
NEXT_PUBLIC_SITE_URL=https://vriksh-seva-samiti.netlify.app

# Secret key (starts with sb_secret_). SERVER/LAPTOP ONLY — never prefix with NEXT_PUBLIC_,
# never commit it. The website does not need it; it is used only by `npm run admin:create`
# on your own computer. Do NOT add it to Netlify.
SUPABASE_SECRET_KEY=
